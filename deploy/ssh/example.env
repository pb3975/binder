# Copy to deploy/ssh/local.env (ignored by git) and fill in. Read by deploy/ssh/ship.sh.
DEPLOY_SSH=root@myhost.example-tailnet.ts.net        # SSH target with Docker and Tailscale
DEPLOY_DIR=/srv/binder                               # data lives in $DEPLOY_DIR/data
BINDER_PUBLIC_URL=https://myhost.example-tailnet.ts.net:8480
BINDER_ALLOWED_USERS=you@example.com                 # first deploy only; later deploys keep the running value
# HOST_PORT=18480                                    # loopback port on the host
# CONTAINER_USER=1000:1000                           # run as this host user (for example a NAS's nobody:users)
# IMAGE_TARGET=full                                  # full (previews) or slim
# TZ=UTC
# EXTRA_LABEL=net.unraid.docker.webui=https://myhost.example-tailnet.ts.net:8480

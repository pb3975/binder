{
  "realm": "binder",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "Binder e2e (synthetic)",
  "groups": [{ "name": "binder-users" }],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "groups": ["/binder-users"],
      "credentials": [{ "type": "password", "value": "alice-e2e-password", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob-e2e-password", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "binder",
      "name": "Binder",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "binder-e2e-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8480/auth/callback"],
      "webOrigins": ["http://127.0.0.1:8480"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
